# Copiar a .env.prod y rellenar. NO commitear .env.prod.
# Uso: docker compose --env-file .env.prod -f docker-compose.prod.yml up -d --build

# --- Database ---
# Postgres externo (gestionado, droplet, RDS, etc.). El backend corre prisma migrate
# deploy contra esta URL en cada arranque.
DATABASE_URL=postgresql://user:password@host:5432/dbname?schema=public

# --- Backend ---
# Generá uno largo y aleatorio: openssl rand -base64 48
JWT_SECRET=cambiame-por-uno-aleatorio-muy-largo
JWT_EXPIRES_IN=7d

# Origen permitido para CORS. Como nginx sirve front y proxea /api en el mismo origin,
# poné acá el dominio público (ej. https://miganado.tudominio.com).
CORS_ORIGIN=https://miganado.tudominio.com

# Claude (opcional, para importar planilla desde imagen)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Cloudflare R2 (fotos) ---
# Account ID está en el dashboard de R2 (también en el endpoint S3 API).
R2_ACCOUNT_ID=
# API Token con permisos de Object Read & Write para el bucket.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=miganado-fotos
# URL pública del bucket. Ej: https://pub-abc123.r2.dev  (sin slash al final)
R2_PUBLIC_URL=

# --- Frontend ---
# Puerto público del host donde escucha nginx. 80 si no hay reverse proxy delante.
HTTP_PORT=80
