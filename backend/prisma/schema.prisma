generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Sexo {
  VP // Vaca parida
  HV // Hembra de vientre / novilla
  HL // Hembra de levante / ternera
  ML // Macho de levante / ternero
  MC // Macho de ceba
  TO // Toro
}

enum CriaSexo {
  M
  H
}

enum TrasladoRol {
  DUENO    // se transfiere la propiedad del lote
  CUIDADOR // se asigna el cuidado del lote
}

enum TrasladoEstado {
  PENDIENTE
  ACEPTADO
  RECHAZADO
  CANCELADO
}

model User {
  id           String   @id @default(cuid())
  documento    String   @unique
  nombre       String
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  lotesPropios       Lote[]     @relation("LoteDueno")
  lotesCuidados      Lote[]     @relation("LoteCuidador")
  trasladosRecibidos Traslado[] @relation("TrasladoPara")
  trasladosCreados   Traslado[] @relation("TrasladoCreadoPor")
  potreros           Potrero[]
  fincas             Finca[]
}

model Finca {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  nombre      String
  capacidad   Int       @default(16) // ancho del mapa en columnas: 16 | 32 | 64
  propiedades Json?
  potreros    Potrero[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId])
}

model Potrero {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  fincaId      String
  finca        Finca     @relation(fields: [fincaId], references: [id], onDelete: Cascade)
  nombre       String
  ocupado      Boolean   @default(false)
  ocupadoDesde DateTime?
  vacioDesde   DateTime?
  notas        String?
  metadatos    Json?
  gridX        Int?
  gridY        Int?
  gridW        Int       @default(1)
  gridH        Int       @default(1)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([userId])
  @@index([fincaId])
}

model Lote {
  id           String   @id @default(cuid())
  duenoId      String
  dueno        User     @relation("LoteDueno", fields: [duenoId], references: [id], onDelete: Cascade)
  cuidadorId   String?
  cuidador     User?    @relation("LoteCuidador", fields: [cuidadorId], references: [id], onDelete: SetNull)
  fecha        DateTime
  numeroFeria  String?
  loteNumero   String?
  sexo         Sexo
  cantidad     Int      @default(1)
  pesoTotal    Decimal  @db.Decimal(12, 2) @default(0)
  pesoPromedio Decimal? @db.Decimal(12, 2)
  valorFinal   Decimal  @db.Decimal(14, 2) @default(0)
  valorTotal   Decimal  @db.Decimal(14, 2) @default(0)
  deduccion    Decimal  @db.Decimal(14, 2) @default(0)
  referencia   String?
  valorAPagar  Decimal  @db.Decimal(14, 2) @default(0)
  criasMacho   Int      @default(0)
  criasHembra  Int      @default(0)
  notas        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  animales    Animal[]
  gastos      Gasto[]
  fotos       Foto[]
  anotaciones Anotacion[]
  traslados   Traslado[]

  @@index([duenoId, fecha])
  @@index([cuidadorId])
}

model Animal {
  id         String   @id @default(cuid())
  loteId     String
  lote       Lote     @relation(fields: [loteId], references: [id], onDelete: Cascade)
  identificador String?
  sexo       Sexo
  peso       Decimal? @db.Decimal(12, 2)
  criaSexo   CriaSexo?
  notas      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  fotos       Foto[]
  anotaciones Anotacion[]

  @@index([loteId])
}

model Gasto {
  id          String   @id @default(cuid())
  loteId      String
  lote        Lote     @relation(fields: [loteId], references: [id], onDelete: Cascade)
  descripcion String
  monto       Decimal  @db.Decimal(14, 2)
  fecha       DateTime @default(now())
  createdAt   DateTime @default(now())

  anotaciones Anotacion[]

  @@index([loteId])
}

model Foto {
  id        String   @id @default(cuid())
  loteId    String?
  lote      Lote?    @relation(fields: [loteId], references: [id], onDelete: Cascade)
  animalId  String?
  animal    Animal?  @relation(fields: [animalId], references: [id], onDelete: Cascade)
  filename  String
  mimetype  String
  size      Int
  createdAt DateTime @default(now())

  @@index([loteId])
  @@index([animalId])
}

model Anotacion {
  id        String   @id @default(cuid())
  loteId    String?
  lote      Lote?    @relation(fields: [loteId], references: [id], onDelete: Cascade)
  animalId  String?
  animal    Animal?  @relation(fields: [animalId], references: [id], onDelete: Cascade)
  gastoId   String?
  gasto     Gasto?   @relation(fields: [gastoId], references: [id], onDelete: Cascade)
  texto     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([loteId])
  @@index([animalId])
  @@index([gastoId])
}

// Traspaso de un rol (dueño o cuidador) de un lote a otro usuario.
// Queda PENDIENTE hasta que el destinatario lo acepte; recién ahí el lote
// cambia de dueño/cuidador. Da control real al que recibe el ganado.
model Traslado {
  id           String         @id @default(cuid())
  loteId       String
  lote         Lote           @relation(fields: [loteId], references: [id], onDelete: Cascade)
  rol          TrasladoRol
  paraUserId   String
  para         User           @relation("TrasladoPara", fields: [paraUserId], references: [id], onDelete: Cascade)
  creadoPorId  String
  creadoPor    User           @relation("TrasladoCreadoPor", fields: [creadoPorId], references: [id], onDelete: Cascade)
  estado       TrasladoEstado @default(PENDIENTE)
  mensaje      String?
  createdAt    DateTime       @default(now())
  respondidoAt DateTime?

  @@index([loteId])
  @@index([paraUserId])
  @@index([creadoPorId])
}
