generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Sexo {
  VP // Vaca parida
  HV // Hembra de vientre / novilla
  HL // Hembra de levante / ternera
  ML // Macho de levante / ternero
  MC // Macho de ceba
  TO // Toro
}

enum CriaSexo {
  M
  H
}

// Estado de un evento de preñez de una vaca:
// PRENADA = preñez confirmada, esperando parto (evento abierto)
// PARIO   = ya parió (se completó con fecha de parto y conteo de crías)
// ABORTO  = perdió la preñez (evento cerrado sin crías)
enum TipoGasto {
  TRANSPORTE
  COMISION_CUIDADOR
  VACUNAS
  DESPARASITANTE
  MEDICAMENTOS
  ALIMENTACION
  ARRIENDO_PASTO
  JORNALES
  DOCUMENTOS
  OTRO
}

enum PrenezEstado {
  PRENADA
  PARIO
  ABORTO
}

enum TrasladoRol {
  DUENO    // se transfiere la propiedad de la finca
  CUIDADOR // se asigna el cuidado de la finca
}

enum TrasladoEstado {
  PENDIENTE
  ACEPTADO
  RECHAZADO
  CANCELADO
}

model User {
  id           String   @id @default(cuid())
  documento    String   @unique
  nombre       String
  passwordHash String
  // Bot de Telegram propio de la cuenta: el token va cifrado (TELEGRAM_TOKEN_KEY) y
  // telegramBotId evita que dos cuentas usen el mismo bot. telegramChatId es el chat
  // vinculado (el único al que el bot le responde); se vincula con un código de un
  // solo uso que la app entrega como link t.me/<bot>?start=<código>.
  telegramBotToken      String?
  telegramBotId         String?   @unique
  telegramBotUsername   String?
  telegramChatId        String?
  telegramCodigo        String?   @unique
  telegramCodigoExpira  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  fincasPropias      Finca[]    @relation("FincaDueno")
  fincasCuidadas     Finca[]    @relation("FincaCuidador")
  trasladosRecibidos Traslado[] @relation("TrasladoPara")
  trasladosCreados   Traslado[] @relation("TrasladoCreadoPor")
}

// La finca es la unidad de propiedad: tiene un dueño y (opcional) un cuidador.
// Todo lo que vive en la finca (potreros y lotes) hereda quién la posee y la cuida.
model Finca {
  id          String     @id @default(cuid())
  duenoId     String
  dueno       User       @relation("FincaDueno", fields: [duenoId], references: [id], onDelete: Cascade)
  cuidadorId  String?
  cuidador    User?      @relation("FincaCuidador", fields: [cuidadorId], references: [id], onDelete: SetNull)
  nombre      String
  capacidad   Int        @default(16) // ancho del mapa en columnas: 16 | 32 | 64
  propiedades Json?
  potreros    Potrero[]
  lotes       Lote[]
  traslados   Traslado[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([duenoId])
  @@index([cuidadorId])
}

model Potrero {
  id           String    @id @default(cuid())
  fincaId      String
  finca        Finca     @relation(fields: [fincaId], references: [id], onDelete: Cascade)
  nombre       String
  ocupado      Boolean   @default(false)
  ocupadoDesde DateTime?
  vacioDesde   DateTime?
  notas        String?
  metadatos    Json?
  gridX        Int?
  gridY        Int?
  gridW        Int       @default(1)
  gridH        Int       @default(1)
  lotes        Lote[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([fincaId])
}

model Lote {
  id           String   @id @default(cuid())
  fincaId      String
  finca        Finca    @relation(fields: [fincaId], references: [id], onDelete: Cascade)
  // Potrero donde está pastando hoy el lote (null = sin asignar). potreroDesde marca
  // cuándo entró, para contar días de ocupación.
  potreroId    String?
  potrero      Potrero? @relation(fields: [potreroId], references: [id], onDelete: SetNull)
  potreroDesde DateTime?
  fecha        DateTime
  numeroFeria  String?
  loteNumero   String?
  sexo         Sexo
  cantidad     Int      @default(1)
  pesoTotal    Decimal  @db.Decimal(12, 2) @default(0)
  pesoPromedio Decimal? @db.Decimal(12, 2)
  valorFinal   Decimal  @db.Decimal(14, 2) @default(0)
  valorTotal   Decimal  @db.Decimal(14, 2) @default(0)
  deduccion    Decimal  @db.Decimal(14, 2) @default(0)
  referencia   String?
  valorAPagar  Decimal  @db.Decimal(14, 2) @default(0)
  criasMacho   Int      @default(0)
  criasHembra  Int      @default(0)
  notas        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  animales    Animal[]
  gastos      Gasto[]
  fotos       Foto[]
  anotaciones Anotacion[]
  pesajes     Pesaje[]
  ventas      Venta[]

  @@index([fincaId, fecha])
  @@index([potreroId])
}

// Pesaje del lote completo (manejo por grupo): una fila = fecha + cantidad de
// cabezas pesadas + peso total. La app calcula promedio por cabeza y la ganancia
// media diaria (GMD) entre pesajes consecutivos. La cantidad puede diferir de la
// del lote cuando hubo venta parcial o baja.
model Pesaje {
  id        String   @id @default(cuid())
  loteId    String
  lote      Lote     @relation(fields: [loteId], references: [id], onDelete: Cascade)
  fecha     DateTime
  cantidad  Int
  pesoTotal Decimal  @db.Decimal(12, 2)
  notas     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([loteId, fecha])
}

model Animal {
  id         String   @id @default(cuid())
  loteId     String
  lote       Lote     @relation(fields: [loteId], references: [id], onDelete: Cascade)
  identificador String?
  sexo       Sexo
  peso       Decimal? @db.Decimal(12, 2)
  criaSexo   CriaSexo?
  // Cría que vino al pie de una VP y se separó para venderse sola: apunta a su
  // madre (trazabilidad). No es una cabeza comprada, así que no cuenta en el lote.
  madreId    String?
  madre      Animal?  @relation("MadreCria", fields: [madreId], references: [id], onDelete: SetNull)
  crias      Animal[] @relation("MadreCria")
  // Cría al pie: no fue una cabeza comprada (su venta no descuenta cabezas). Puede
  // ir pegada a una madre registrada (madreId) o solo al lote, si las vacas no están
  // registradas una por una. `nacimiento` es la fecha en que nació, o en que llegó
  // si vino con la vaca (vinoConMadre). Al destetarse deja de estar al pie y queda
  // como animal de levante del lote; `muerteFecha` la saca de la finca.
  esCria       Boolean   @default(false)
  nacimiento   DateTime?
  vinoConMadre Boolean   @default(false)
  destetadoAt  DateTime?
  muerteFecha  DateTime?
  notas      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  fotos       Foto[]
  anotaciones Anotacion[]
  prenez      Prenez[]
  venta       Venta?

  @@index([loteId])
  @@index([madreId])
}

// Evento reproductivo de una vaca: arranca cuando se le confirma la preñez y se
// completa cuando pare (fecha de parto + cuántas crías macho/hembra) o aborta.
// Una vaca puede tener varios a lo largo de su vida → es el histórico de partos.
model Prenez {
  id              String       @id @default(cuid())
  animalId        String
  animal          Animal       @relation(fields: [animalId], references: [id], onDelete: Cascade)
  estado          PrenezEstado @default(PRENADA)
  fechaDiagnostico DateTime    // cuándo se confirmó la preñez
  fechaParto      DateTime?    // cuándo parió (al cerrar como PARIO)
  criasMacho      Int          @default(0)
  criasHembra     Int          @default(0)
  notas           String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([animalId])
}

model Gasto {
  id          String   @id @default(cuid())
  loteId      String
  lote        Lote     @relation(fields: [loteId], references: [id], onDelete: Cascade)
  tipo        TipoGasto @default(OTRO)
  descripcion String // detalle libre; puede ir vacío salvo en OTRO
  monto       Decimal  @db.Decimal(14, 2)
  pagado      Boolean  @default(true) // false = se debe (p. ej. comisión del cuidador que se salda en la venta)
  fecha       DateTime @default(now())
  createdAt   DateTime @default(now())

  anotaciones Anotacion[]

  @@index([loteId])
  @@index([tipo])
}

// Salida (venta) de ganado del lote. Un lote tiene 1 entrada y N salidas: se
// sacan las cabezas que ya están listas y el resto sigue cebándose, así que la
// venta parcial es la norma. El lote queda abierto hasta que la suma de
// cantidades vendidas iguala la cantidad comprada. Cuando la salida es de un
// animal registrado individualmente, `animalId` lo apunta (y ese animal queda
// vendido; por eso es único).
model Venta {
  id            String   @id @default(cuid())
  loteId        String
  lote          Lote     @relation(fields: [loteId], references: [id], onDelete: Cascade)
  animalId      String?  @unique
  animal        Animal?  @relation(fields: [animalId], references: [id], onDelete: Cascade)
  fecha         DateTime
  cantidad      Int      @default(1)
  pesoTotal     Decimal? @db.Decimal(12, 2) // peso de salida; opcional: a veces se vende por cabeza, sin báscula
  valorTotal    Decimal  @db.Decimal(14, 2) @default(0) // bruto, antes de deducciones
  deduccion     Decimal  @db.Decimal(14, 2) @default(0) // comisión, báscula
  valorRecibido Decimal  @db.Decimal(14, 2) @default(0) // neto que entra al bolsillo
  comprador     String?
  notas         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([loteId, fecha])
}

model Foto {
  id        String   @id @default(cuid())
  loteId    String?
  lote      Lote?    @relation(fields: [loteId], references: [id], onDelete: Cascade)
  animalId  String?
  animal    Animal?  @relation(fields: [animalId], references: [id], onDelete: Cascade)
  filename  String
  mimetype  String
  size      Int
  createdAt DateTime @default(now())

  @@index([loteId])
  @@index([animalId])
}

model Anotacion {
  id        String   @id @default(cuid())
  loteId    String?
  lote      Lote?    @relation(fields: [loteId], references: [id], onDelete: Cascade)
  animalId  String?
  animal    Animal?  @relation(fields: [animalId], references: [id], onDelete: Cascade)
  gastoId   String?
  gasto     Gasto?   @relation(fields: [gastoId], references: [id], onDelete: Cascade)
  texto     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([loteId])
  @@index([animalId])
  @@index([gastoId])
}

// Traspaso de un rol (dueño o cuidador) de una finca a otro usuario.
// Queda PENDIENTE hasta que el destinatario lo acepte; recién ahí la finca
// cambia de dueño/cuidador (y con ella todos sus potreros y lotes).
model Traslado {
  id           String         @id @default(cuid())
  fincaId      String
  finca        Finca          @relation(fields: [fincaId], references: [id], onDelete: Cascade)
  rol          TrasladoRol
  paraUserId   String
  para         User           @relation("TrasladoPara", fields: [paraUserId], references: [id], onDelete: Cascade)
  creadoPorId  String
  creadoPor    User           @relation("TrasladoCreadoPor", fields: [creadoPorId], references: [id], onDelete: Cascade)
  estado       TrasladoEstado @default(PENDIENTE)
  mensaje      String?
  createdAt    DateTime       @default(now())
  respondidoAt DateTime?

  @@index([fincaId])
  @@index([paraUserId])
  @@index([creadoPorId])
}
