generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Sexo {
  VP // Vaca parida
  HV // Hembra de vientre / novilla
  HL // Hembra de levante / ternera
  ML // Macho de levante / ternero
  MC // Macho de ceba
  TO // Toro
}

enum CriaSexo {
  M
  H
}

model User {
  id           String   @id @default(cuid())
  documento    String   @unique
  nombre       String
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  lotes    Lote[]
  potreros Potrero[]
  fincas   Finca[]
  grupos   Grupo[]
}

model Finca {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  nombre      String
  capacidad   Int       @default(16) // ancho del mapa en columnas: 16 | 32 | 64
  propiedades Json?
  potreros    Potrero[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId])
}

model Potrero {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  fincaId      String
  finca        Finca     @relation(fields: [fincaId], references: [id], onDelete: Cascade)
  nombre       String
  ocupado      Boolean   @default(false)
  ocupadoDesde DateTime?
  vacioDesde   DateTime?
  notas        String?
  metadatos    Json?
  gridX        Int?
  gridY        Int?
  gridW        Int       @default(1)
  gridH        Int       @default(1)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  grupos       Grupo[]

  @@index([userId])
  @@index([fincaId])
}

model Lote {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fecha        DateTime
  numeroFeria  String?
  loteNumero   String?
  sexo         Sexo
  cantidad     Int      @default(1)
  pesoTotal    Decimal  @db.Decimal(12, 2) @default(0)
  pesoPromedio Decimal? @db.Decimal(12, 2)
  valorFinal   Decimal  @db.Decimal(14, 2) @default(0)
  valorTotal   Decimal  @db.Decimal(14, 2) @default(0)
  deduccion    Decimal  @db.Decimal(14, 2) @default(0)
  referencia   String?
  valorAPagar  Decimal  @db.Decimal(14, 2) @default(0)
  criasMacho   Int      @default(0)
  criasHembra  Int      @default(0)
  notas        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  animales    Animal[]
  gastos      Gasto[]
  fotos       Foto[]
  anotaciones Anotacion[]
  grupos      Grupo[]

  @@index([userId, fecha])
}

// Un Grupo es una "punta" de ganado que se maneja junta en el campo: vive en un
// potrero y se rota entre potreros. Es un concepto OPERATIVO, distinto del Lote
// (que es comercial/contable). Al registrar un lote se crea un grupo con sus
// cabezas; luego el ganadero lo asigna a un potrero, lo divide por sexo/peso o
// lo fusiona con otro. potreroId nulo = ganado sin ubicar todavía.
model Grupo {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  nombre         String
  sexo           Sexo
  cantidad       Int       @default(1)
  potreroId      String?
  potrero        Potrero?  @relation(fields: [potreroId], references: [id], onDelete: SetNull)
  ingresoPotrero DateTime? // cuándo entró al potrero actual (para los días de pastoreo)
  loteId         String?
  lote           Lote?     @relation(fields: [loteId], references: [id], onDelete: SetNull)
  notas          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([userId])
  @@index([potreroId])
  @@index([loteId])
}

model Animal {
  id         String   @id @default(cuid())
  loteId     String
  lote       Lote     @relation(fields: [loteId], references: [id], onDelete: Cascade)
  identificador String?
  sexo       Sexo
  peso       Decimal? @db.Decimal(12, 2)
  criaSexo   CriaSexo?
  notas      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  fotos       Foto[]
  anotaciones Anotacion[]

  @@index([loteId])
}

model Gasto {
  id          String   @id @default(cuid())
  loteId      String
  lote        Lote     @relation(fields: [loteId], references: [id], onDelete: Cascade)
  descripcion String
  monto       Decimal  @db.Decimal(14, 2)
  fecha       DateTime @default(now())
  createdAt   DateTime @default(now())

  anotaciones Anotacion[]

  @@index([loteId])
}

model Foto {
  id        String   @id @default(cuid())
  loteId    String?
  lote      Lote?    @relation(fields: [loteId], references: [id], onDelete: Cascade)
  animalId  String?
  animal    Animal?  @relation(fields: [animalId], references: [id], onDelete: Cascade)
  filename  String
  mimetype  String
  size      Int
  createdAt DateTime @default(now())

  @@index([loteId])
  @@index([animalId])
}

model Anotacion {
  id        String   @id @default(cuid())
  loteId    String?
  lote      Lote?    @relation(fields: [loteId], references: [id], onDelete: Cascade)
  animalId  String?
  animal    Animal?  @relation(fields: [animalId], references: [id], onDelete: Cascade)
  gastoId   String?
  gasto     Gasto?   @relation(fields: [gastoId], references: [id], onDelete: Cascade)
  texto     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([loteId])
  @@index([animalId])
  @@index([gastoId])
}
