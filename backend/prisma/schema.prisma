generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Sexo {
  VP // Vaca parida
  HV // Hembra de vientre / novilla
  HL // Hembra de levante / ternera
  ML // Macho de levante / ternero
  MC // Macho de ceba
  TO // Toro
}

enum CriaSexo {
  M
  H
}

enum TrasladoRol {
  DUENO    // se transfiere la propiedad de la finca
  CUIDADOR // se asigna el cuidado de la finca
}

enum TrasladoEstado {
  PENDIENTE
  ACEPTADO
  RECHAZADO
  CANCELADO
}

model User {
  id           String   @id @default(cuid())
  documento    String   @unique
  nombre       String
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  fincasPropias      Finca[]    @relation("FincaDueno")
  fincasCuidadas     Finca[]    @relation("FincaCuidador")
  trasladosRecibidos Traslado[] @relation("TrasladoPara")
  trasladosCreados   Traslado[] @relation("TrasladoCreadoPor")
}

// La finca es la unidad de propiedad: tiene un dueño y (opcional) un cuidador.
// Todo lo que vive en la finca (potreros y lotes) hereda quién la posee y la cuida.
model Finca {
  id          String     @id @default(cuid())
  duenoId     String
  dueno       User       @relation("FincaDueno", fields: [duenoId], references: [id], onDelete: Cascade)
  cuidadorId  String?
  cuidador    User?      @relation("FincaCuidador", fields: [cuidadorId], references: [id], onDelete: SetNull)
  nombre      String
  capacidad   Int        @default(16) // ancho del mapa en columnas: 16 | 32 | 64
  propiedades Json?
  potreros    Potrero[]
  lotes       Lote[]
  traslados   Traslado[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([duenoId])
  @@index([cuidadorId])
}

model Potrero {
  id           String    @id @default(cuid())
  fincaId      String
  finca        Finca     @relation(fields: [fincaId], references: [id], onDelete: Cascade)
  nombre       String
  ocupado      Boolean   @default(false)
  ocupadoDesde DateTime?
  vacioDesde   DateTime?
  notas        String?
  metadatos    Json?
  gridX        Int?
  gridY        Int?
  gridW        Int       @default(1)
  gridH        Int       @default(1)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([fincaId])
}

model Lote {
  id           String   @id @default(cuid())
  fincaId      String
  finca        Finca    @relation(fields: [fincaId], references: [id], onDelete: Cascade)
  fecha        DateTime
  numeroFeria  String?
  loteNumero   String?
  sexo         Sexo
  cantidad     Int      @default(1)
  pesoTotal    Decimal  @db.Decimal(12, 2) @default(0)
  pesoPromedio Decimal? @db.Decimal(12, 2)
  valorFinal   Decimal  @db.Decimal(14, 2) @default(0)
  valorTotal   Decimal  @db.Decimal(14, 2) @default(0)
  deduccion    Decimal  @db.Decimal(14, 2) @default(0)
  referencia   String?
  valorAPagar  Decimal  @db.Decimal(14, 2) @default(0)
  criasMacho   Int      @default(0)
  criasHembra  Int      @default(0)
  notas        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  animales    Animal[]
  gastos      Gasto[]
  fotos       Foto[]
  anotaciones Anotacion[]
  pesajes     Pesaje[]

  @@index([fincaId, fecha])
}

// Pesaje del lote completo (manejo por grupo): una fila = fecha + cantidad de
// cabezas pesadas + peso total. La app calcula promedio por cabeza y la ganancia
// media diaria (GMD) entre pesajes consecutivos. La cantidad puede diferir de la
// del lote cuando hubo venta parcial o baja.
model Pesaje {
  id        String   @id @default(cuid())
  loteId    String
  lote      Lote     @relation(fields: [loteId], references: [id], onDelete: Cascade)
  fecha     DateTime
  cantidad  Int
  pesoTotal Decimal  @db.Decimal(12, 2)
  notas     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([loteId, fecha])
}

model Animal {
  id         String   @id @default(cuid())
  loteId     String
  lote       Lote     @relation(fields: [loteId], references: [id], onDelete: Cascade)
  identificador String?
  sexo       Sexo
  peso       Decimal? @db.Decimal(12, 2)
  criaSexo   CriaSexo?
  notas      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  fotos       Foto[]
  anotaciones Anotacion[]

  @@index([loteId])
}

model Gasto {
  id          String   @id @default(cuid())
  loteId      String
  lote        Lote     @relation(fields: [loteId], references: [id], onDelete: Cascade)
  descripcion String
  monto       Decimal  @db.Decimal(14, 2)
  fecha       DateTime @default(now())
  createdAt   DateTime @default(now())

  anotaciones Anotacion[]

  @@index([loteId])
}

model Foto {
  id        String   @id @default(cuid())
  loteId    String?
  lote      Lote?    @relation(fields: [loteId], references: [id], onDelete: Cascade)
  animalId  String?
  animal    Animal?  @relation(fields: [animalId], references: [id], onDelete: Cascade)
  filename  String
  mimetype  String
  size      Int
  createdAt DateTime @default(now())

  @@index([loteId])
  @@index([animalId])
}

model Anotacion {
  id        String   @id @default(cuid())
  loteId    String?
  lote      Lote?    @relation(fields: [loteId], references: [id], onDelete: Cascade)
  animalId  String?
  animal    Animal?  @relation(fields: [animalId], references: [id], onDelete: Cascade)
  gastoId   String?
  gasto     Gasto?   @relation(fields: [gastoId], references: [id], onDelete: Cascade)
  texto     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([loteId])
  @@index([animalId])
  @@index([gastoId])
}

// Traspaso de un rol (dueño o cuidador) de una finca a otro usuario.
// Queda PENDIENTE hasta que el destinatario lo acepte; recién ahí la finca
// cambia de dueño/cuidador (y con ella todos sus potreros y lotes).
model Traslado {
  id           String         @id @default(cuid())
  fincaId      String
  finca        Finca          @relation(fields: [fincaId], references: [id], onDelete: Cascade)
  rol          TrasladoRol
  paraUserId   String
  para         User           @relation("TrasladoPara", fields: [paraUserId], references: [id], onDelete: Cascade)
  creadoPorId  String
  creadoPor    User           @relation("TrasladoCreadoPor", fields: [creadoPorId], references: [id], onDelete: Cascade)
  estado       TrasladoEstado @default(PENDIENTE)
  mensaje      String?
  createdAt    DateTime       @default(now())
  respondidoAt DateTime?

  @@index([fincaId])
  @@index([paraUserId])
  @@index([creadoPorId])
}
